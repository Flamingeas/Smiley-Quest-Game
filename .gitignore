## ===============================
## 🧱 GRADLE BUILD SYSTEM
## ===============================
.gradle/
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar
!gradlew
!gradlew.bat

# Gradle local cache & temporary files
.gradle/
**/.gradle/
.gradle-cache/
.gradle-test-kit/

# Logs
*.log
logs/
build/reports/

## ===============================
## 🎮 LIBGDX PROJECT STRUCTURE
## ===============================
# Ignore compiled output and binaries for all modules
libGDX/**/build/
libGDX/**/bin/
libGDX/**/out/
libGDX/**/dist/
libGDX/**/tmp/

# Assets auto-generated
libGDX/**/assets/assets.txt

# Native builds
libGDX/**/native/
libGDX/**/libs/*.so
libGDX/**/libs/*.dll
libGDX/**/libs/*.dylib

